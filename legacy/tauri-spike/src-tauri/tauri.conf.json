{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YoutubeDiscordPanel Spike",
  "version": "1.9.2",
  "identifier": "com.ydp.zapretpanel.spike",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "YoutubeDiscordPanel",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"],
    "targets": "all"
  }
}
