<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Targets .NET Framework 4.8 on purpose:
      - the runtime ships with every supported Windows, so the panel needs NO
        installer for a runtime (Electron needed 113 MB and Tauri still needs
        WebView2);
      - the exe stays at 1-3 MB with zero dependencies;
      - no Chromium / WebView2 process tree: one process, ~40-60 MB.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>YoutubeDiscordPanel</AssemblyName>
    <RootNamespace>Ydp</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>YoutubeDiscordPanel</AssemblyTitle>
    <Product>YoutubeDiscordPanel</Product>
    <Version>2.1.17</Version>
    <FileVersion>2.1.17.0</FileVersion>
    <AssemblyVersion>2.1.17.0</AssemblyVersion>
    <NeutralLanguage>ru</NeutralLanguage>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Deterministic, trimmed build: no pdb, no extra docs in the output. -->
    <SatelliteResourcePaths>en;ru</SatelliteResourcePaths>
  </PropertyGroup>

  <ItemGroup>
    <!-- The installer is a separate project; its sources (and its generated
         AssemblyInfo) must not be globbed into the panel. -->
    <Compile Remove="setup\**" />
    <None Remove="setup\**" />
    <Page Remove="setup\**" />
    <EmbeddedResource Remove="setup\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- ServiceController for the SCM queries (no sc.exe child processes). -->
    <Reference Include="System.ServiceProcess" />
    <!-- FolderBrowserDialog: net48 has no OpenFolderDialog. -->
    <Reference Include="System.Windows.Forms" />
    <!-- ZipArchive / ZipFile for the engine updater (BCL, no NuGet package). -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- Reference assemblies so net48 builds on a machine without Visual Studio. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>




