<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Installer for the panel.

    Deliberately a second tiny net48 exe instead of Inno/NSIS: the panel itself
    needs no runtime, so neither should its installer. This one is ~50 KB and
    copies the files, makes the shortcuts, registers the uninstall entry and the
    login item - no bundler, no payload compression, no 5 MB runtime.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>false</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>YoutubeDiscordPanel-Setup</AssemblyName>
    <RootNamespace>Ydp.Setup</RootNamespace>
    <ApplicationIcon>..\Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>YoutubeDiscordPanel</Product>
    <Version>2.1.11</Version>
    <FileVersion>2.1.11.0</FileVersion>
    <DebugType>none</DebugType>
    <!-- We define Main ourselves; the SDK also generates one for WinExe. -->
    <StartupObject>Ydp.Setup.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- WScript.Shell via late binding needs Microsoft.CSharp. -->
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

<ItemGroup>
    <!--
      The installer is self-contained: the panel exe and the offline zapret
      archive travel inside it. Asking the user to download two files and keep
      them in the same folder is a real failure mode - the website offers one
      file, and the setup then refused to run with "no YoutubeDiscordPanel.exe
      next to the installer".
    -->
    <EmbeddedResource Include="..\bin\Release\net48\YoutubeDiscordPanel.exe"
                      LogicalName="Setup.Payload.panel.exe"
                      Condition="Exists('..\bin\Release\net48\YoutubeDiscordPanel.exe')" />
    <EmbeddedResource Include="Payload\zapret-bundled.zip"
                      LogicalName="Setup.Payload.zapret.zip"
                      Condition="Exists('Payload\zapret-bundled.zip')" />
  </ItemGroup>

</Project>
