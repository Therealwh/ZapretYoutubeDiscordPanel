<Window x:Class="Ydp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="YoutubeDiscordPanel" Height="900" Width="1400"
        MinHeight="700" MinWidth="1000"
Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <!--
      Custom title bar. The system caption cannot be darkened on this machine:
      DWMWA_USE_IMMERSIVE_DARK_MODE returns success but the bar still paints
      white, and DWMWA_CAPTION_COLOR / TEXT_COLOR are rejected with
      E_INVALIDARG (verified with a standalone probe on Windows 10 22H2).
      So the caption is drawn ourselves and the system frame is removed.
      CaptionHeight gives us drag + double-click-to-maximize for free;
      the buttons opt back into hit testing.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Sidebar item: a coloured rail marks the active page, so the current
             section is obvious at a glance instead of relying on a subtle
             fill. Icons are vector shapes - no icon font to go missing. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="rail" Width="3" Height="20" CornerRadius="2"
                                    HorizontalAlignment="Left" Background="Transparent" />
                            <Border x:Name="bg" CornerRadius="10" Padding="14,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentTileBrush}" />
                                <Setter TargetName="rail" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caption buttons: flat, hover like every other desktop app -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource ErrBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav icons: vector strokes that inherit the item's colour, so the
             active item lights up together with its label. -->
        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,11,0" />
        </Style>

        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="YoutubeDiscordPanel" Margin="14,0,0,0"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextDimBrush}" />
                <!-- Icons are drawn as vectors on purpose: the Segoe MDL2 Assets glyphs
             render as empty boxes on machines where that font is absent. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Style="{StaticResource CaptionButton}" ToolTip="Свернуть" Click="Minimize_Click">
                <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" />
            </Button>
            <Button x:Name="BtnCaptionMax" Style="{StaticResource CaptionButton}" ToolTip="Развернуть" Click="Maximize_Click">
                <Path Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" />
            </Button>
            <Button Style="{StaticResource CloseButton}" ToolTip="Закрыть" Click="Close_Click">
                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" />
            </Button>
        </StackPanel>
            </Grid>
        </Border>

        <!-- Update banner. Hidden until the startup check finds a newer
             release; lives above the content on every page so the offer is
             impossible to miss but never blocks navigation. -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Margin="24,12,24,0" Padding="14,10"
                Background="{DynamicResource AccentTileBrush}" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="UpdateDetails" Style="{StaticResource Dim}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnUpdateNow" Content="Обновить" Style="{StaticResource BtnPrimary}"
                            Margin="0,0,8,0" Click="BtnUpdateNow_Click" />
                    <Button Content="Что нового" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="BtnWhatsNew_Click" />
                    <Button Content="✕" Style="{StaticResource Btn}" Padding="10,8" Click="BtnBannerClose_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource BgSideBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Sidebar header -->
                <StackPanel Grid.Row="0" Margin="18,22,12,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Zapret" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="17" Foreground="{DynamicResource TextBrush}" />
                        <Border Background="{DynamicResource AccentTileBrush}" CornerRadius="6" Padding="7,2"
                                Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionBadge" Text="2.x" FontSize="10.5"
                                       Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="обход DPI для Discord и YouTube" FontSize="11"
                               Style="{StaticResource Dim}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <RadioButton x:Name="NavDashboard" AutomationProperties.Name="Обход" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True"
                                 Tag="dashboard" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="M1,1.5 L9,1.5 L9,6 L5,9.5 L1,6 Z" />
                            <TextBlock Style="{StaticResource NavText}" Text="Обход" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavStrategies" AutomationProperties.Name="Стратегии" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="strategies" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="M0.5,2.5 H9.5 M0.5,7 H9.5" />
                            <TextBlock Style="{StaticResource NavText}" Text="Стратегии" />
                        </StackPanel>
                    </RadioButton>
                      <RadioButton x:Name="NavExpert" AutomationProperties.Name="DPI-эксперт" Style="{StaticResource NavItem}" GroupName="nav"
                                   Tag="expert" Checked="Nav_Checked">
                          <StackPanel Orientation="Horizontal">
                              <Path Style="{StaticResource NavIcon}" Data="M2,5 L5,5 L5,2 L8,2 L8,8 L5,8 L5,5 M11,3 L11,11" />
                              <TextBlock Style="{StaticResource NavText}" Text="DPI-эксперт" />
                          </StackPanel>
                      </RadioButton>
                      <RadioButton x:Name="NavFilters" AutomationProperties.Name="Фильтры" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="filters" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="M0.5,0.8 L9.5,0.8 L6.2,5 V9.8 L3.8,8.6 V5 Z" />
                            <TextBlock Style="{StaticResource NavText}" Text="Фильтры" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLists" AutomationProperties.Name="Списки" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="lists" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="M2,0.5 L6.4,0.5 L8.5,2.8 L8.5,9.5 L2,9.5 Z M6.4,0.5 L6.4,2.8 L8.5,2.8" />
                            <TextBlock Style="{StaticResource NavText}" Text="Списки" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavUpdates" AutomationProperties.Name="Обновления" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="updates" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="M9,3.6 A4,4 0 1 0 8.6,6.6 M9,0.6 L9,3.9 L5.9,3.9" />
                            <TextBlock Style="{StaticResource NavText}" Text="Обновления" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDiagnostics" AutomationProperties.Name="Диагностика" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="diagnostics" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="M0.5,5 L3,5 L4.4,1.4 L6.4,8.8 L7.8,5 L9.5,5" />
                            <TextBlock Style="{StaticResource NavText}" Text="Диагностика" />
                        </StackPanel>
                    </RadioButton>
                    <!-- Secondary section below a divider: supporting pages read
                         as a separate group from the working ones. -->
                    <Border Height="1" Background="{DynamicResource BorderBrush2}" Opacity="0.5"
                            Margin="16,10,16,8" />
                    <RadioButton x:Name="NavLogs" AutomationProperties.Name="Логи" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="logs" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="M0.5,2 H9.5 M0.5,5 H9.5 M0.5,8 H6.5" />
                            <TextBlock Style="{StaticResource NavText}" Text="Логи" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" AutomationProperties.Name="Настройки" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="settings" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="M5,1.6 A3.4,3.4 0 1 0 5,8.4 A3.4,3.4 0 1 0 5,1.6 M5,0 L5,1.8 M5,8.2 L5,10 M0,5 L1.8,5 M8.2,5 L10,5" />
                            <TextBlock Style="{StaticResource NavText}" Text="Настройки" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavContacts" AutomationProperties.Name="Контакты" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="contacts" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="M4,3 L16,8.5 L4,14 Z" />
                            <TextBlock Style="{StaticResource NavText}" Text="Контакты" />
                        </StackPanel>
                    </RadioButton>
                      <RadioButton x:Name="NavTransparency" AutomationProperties.Name="Прозрачность" Style="{StaticResource NavItem}" GroupName="nav"
                                   Tag="transparency" Checked="Nav_Checked">
                          <StackPanel Orientation="Horizontal">
                              <Path Style="{StaticResource NavIcon}" Data="M5,1 L5,9 M5,9 L2.5,6.5 M5,9 L7.5,6.5 M9,1.5 L9,14" />
                              <TextBlock Style="{StaticResource NavText}" Text="Прозрачность" />
                          </StackPanel>
                      </RadioButton>
                      <RadioButton x:Name="NavSupport" AutomationProperties.Name="Поддержка" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="support" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="M5,9 C1.5,6 0.5,4 1.8,2.6 A2.4,2.4 0 0 1 5,3.4 A2.4,2.4 0 0 1 8.2,2.6 C9.5,4 8.5,6 5,9 Z" />
                            <TextBlock Style="{StaticResource NavText}" Text="Поддержать" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <TextBlock x:Name="FooterNote" Grid.Row="2" Margin="18,10,12,16" Style="{StaticResource Dim}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Pages -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="24,20,24,20" />
        </Grid>
    </Grid>
</Window>