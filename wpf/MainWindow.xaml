<Window x:Class="Ydp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YoutubeDiscordPanel" Height="900" Width="1400"
        MinHeight="700" MinWidth="1000"
        Background="{StaticResource BgBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Sidebar item, same shape as the HTML .nav-item -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource BgHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource BgCardBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgSideBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="YOUTUBEDISCORDPANEL" Margin="18,20,12,18"
                           FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True"
                                 Content="Обход" Tag="dashboard" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavStrategies" Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Стратегии" Tag="strategies" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavFilters" Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Фильтры" Tag="filters" Checked="Nav_Checked" IsEnabled="False" Opacity="0.5" />
                    <RadioButton x:Name="NavLists" Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Списки" Tag="lists" Checked="Nav_Checked" IsEnabled="False" Opacity="0.5" />
                    <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Обновления" Tag="updates" Checked="Nav_Checked" IsEnabled="False" Opacity="0.5" />
                    <RadioButton x:Name="NavDiagnostics" Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Диагностика" Tag="diagnostics" Checked="Nav_Checked" IsEnabled="False" Opacity="0.5" />
                    <RadioButton x:Name="NavLogs" Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Логи" Tag="logs" Checked="Nav_Checked" IsEnabled="False" Opacity="0.5" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Настройки" Tag="settings" Checked="Nav_Checked" />
                </StackPanel>
                <TextBlock x:Name="FooterNote" Grid.Row="2" Margin="18,10,12,16" Style="{StaticResource Dim}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Pages -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="24,20,24,20" />
    </Grid>
</Window>