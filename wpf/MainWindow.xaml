<Window x:Class="Ydp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="YoutubeDiscordPanel" Height="900" Width="1400"
        MinHeight="700" MinWidth="1000"
        Background="{StaticResource BgBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <!--
      Custom title bar. The system caption cannot be darkened on this machine:
      DWMWA_USE_IMMERSIVE_DARK_MODE returns success but the bar still paints
      white, and DWMWA_CAPTION_COLOR / TEXT_COLOR are rejected with
      E_INVALIDARG (verified with a standalone probe on Windows 10 22H2).
      So the caption is drawn ourselves and the system frame is removed.
      CaptionHeight gives us drag + double-click-to-maximize for free;
      the buttons opt back into hit testing.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Sidebar item, same shape as the HTML .nav-item -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource BgHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource BgCardBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caption buttons: flat, hover like every other desktop app -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E03B3B" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{StaticResource BgBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="YoutubeDiscordPanel" Margin="14,0,0,0"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" />
                <!-- Icons are drawn as vectors on purpose: the Segoe MDL2 Assets glyphs
             render as empty boxes on machines where that font is absent. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Style="{StaticResource CaptionButton}" ToolTip="Свернуть" Click="Minimize_Click">
                <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" />
            </Button>
            <Button x:Name="BtnCaptionMax" Style="{StaticResource CaptionButton}" ToolTip="Развернуть" Click="Maximize_Click">
                <Path Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" />
            </Button>
            <Button Style="{StaticResource CloseButton}" ToolTip="Закрыть" Click="Close_Click">
                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" />
            </Button>
        </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgSideBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="YOUTUBEDISCORDPANEL" Margin="18,20,12,18"
                           FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True"
                                 Content="Обход" Tag="dashboard" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavStrategies" Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Стратегии" Tag="strategies" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavFilters" Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Фильтры" Tag="filters" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavLists" Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Списки" Tag="lists" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Обновления" Tag="updates" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavDiagnostics" Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Диагностика" Tag="diagnostics" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavLogs" Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Логи" Tag="logs" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Настройки" Tag="settings" Checked="Nav_Checked" />
                </StackPanel>
                <TextBlock x:Name="FooterNote" Grid.Row="2" Margin="18,10,12,16" Style="{StaticResource Dim}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Pages -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="24,20,24,20" />
        </Grid>
    </Grid>
</Window>