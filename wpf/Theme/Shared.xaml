<!--
    Shared styles: cards, tiles, text, buttons.

    Theme-independent by construction: every colour comes from the palette via
    DynamicResource, so swapping Palette.Dark.xaml for Palette.Light.xaml at
    runtime restyles the whole app without a restart.

    BasedOn still has to be StaticResource (WPF does not support DynamicResource
    there), but that is fine: the inheritance chain itself never changes, only
    the colours the leaf setters point at.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spoiler blocks in the strategy report: bind Visibility straight to the
         expand flag instead of writing converters at every use. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Tooltips. Implicit style (no x:Key) so it applies to every tooltip in
         the app. Without this, WPF falls back to the system tooltip: a white
         box on the dark UI, and because the tooltip text inherits the app's
         white Foreground it rendered as a blank white bar on hover. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="460" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Content">
                            <ContentPresenter.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.ContentTemplate>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
    </Style>

    <!-- Status tiles. Pages switch between these via SetTile(); border + tint +
         faint glow tell the state, text only confirms it. -->
    <Style x:Key="TileBase" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style x:Key="TileOk" TargetType="Border" BasedOn="{StaticResource TileBase}">
        <Setter Property="Background" Value="{DynamicResource OkTileBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OkSoftBrush}" />
        <Setter Property="Effect" Value="{DynamicResource GlowOk}" />
    </Style>
    <Style x:Key="TileWarn" TargetType="Border" BasedOn="{StaticResource TileBase}">
        <Setter Property="Background" Value="{DynamicResource WarnTileBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarnSoftBrush}" />
        <Setter Property="Effect" Value="{DynamicResource GlowWarn}" />
    </Style>
    <Style x:Key="TileErr" TargetType="Border" BasedOn="{StaticResource TileBase}">
        <Setter Property="Background" Value="{DynamicResource ErrTileBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrSoftBrush}" />
        <Setter Property="Effect" Value="{DynamicResource GlowErr}" />
    </Style>
    <Style x:Key="TileIdle" TargetType="Border" BasedOn="{StaticResource TileBase}" />

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Dim" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Monospace for anything machine-shaped: paths, links, addresses. -->
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    </Style>

    <!-- buttons -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource BtnHoverBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource BtnHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource BtnPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource BtnHoverBorderBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource BtnHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource BtnPressedBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource BtnPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource ErrTileBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource DangerHoverBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource ErrBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource DangerPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      No Foreground here on purpose. An implicit style's setter OUTRANKS an
      inherited value, so setting Foreground here silently overrode every
      control that sets Foreground on purpose — BtnPrimary painted its label in
      theme text colour instead of white (dark text on an indigo button in the
      light theme), and the same applied to selected DataGrid rows and
      ComboBox/CheckBox items. Colour now arrives by inheritance from the Window
      root, and a button's own Foreground reaches its label again.
    -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    </Style>

</ResourceDictionary>