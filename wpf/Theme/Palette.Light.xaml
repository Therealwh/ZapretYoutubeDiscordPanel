<!--
    Light palette: same keys as Palette.Dark.xaml, light values.

    Accent is darkened (#5B57E8) compared to the dark theme: the dark-theme
    indigo only reaches 4.5:1 on near-black, and on white cards it washed out.
    Status hues are likewise darker so text and dots stay readable on white,
    while the tile fills keep the same ~12% tint idea.

    Glows are dialled way down — a coloured blur that reads as depth on a dark
    surface just looks like a smudge on white — and the card shadow switches
    from black to a slate tint so cards lift off the background instead of
    looking like grey holes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgColor">#F1F5F9</Color>
    <Color x:Key="BgSideColor">#E4E9F2</Color>
    <Color x:Key="BgCardColor">#FFFFFF</Color>
    <Color x:Key="BgHoverColor">#E2E8F0</Color>
    <Color x:Key="TextColor">#0F172A</Color>
    <Color x:Key="TextDimColor">#55637A</Color>
    <Color x:Key="BorderColor">#C7D2E0</Color>
    <Color x:Key="AccentColor">#5B57E8</Color>
    <Color x:Key="OkColor">#12833C</Color>
    <Color x:Key="WarnColor">#A35A00</Color>
    <Color x:Key="ErrColor">#C62828</Color>

    <Color x:Key="OkTileColor">#CFEFDB</Color>
    <Color x:Key="WarnTileColor">#FBF0DF</Color>
    <Color x:Key="ErrTileColor">#FBE8EA</Color>
    <Color x:Key="AccentTileColor">#E8E8FD</Color>
    <Color x:Key="OkSoftColor">#47A87A</Color>
    <Color x:Key="WarnSoftColor">#D2A85F</Color>
    <Color x:Key="ErrSoftColor">#DFA0A6</Color>

    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="BtnHoverColor">#D5DEEA</Color>
    <Color x:Key="BtnPressedColor">#C3CEDD</Color>
    <Color x:Key="BtnHoverBorderColor">#8FA0B8</Color>
    <Color x:Key="ScrollThumbColor">#AFBCCD</Color>
    <Color x:Key="RowSelectedColor">#4A50E8</Color>
    <Color x:Key="DangerTextColor">#A3161B</Color>
    <Color x:Key="DangerHoverColor">#F9DCDF</Color>
    <Color x:Key="DangerPressedColor">#F5C7CB</Color>
    <Color x:Key="ShadowColor">#64748B</Color>
    <Color x:Key="PinGoldColor">#B7791F</Color>
    <Color x:Key="SoftAccentColor">#6B67E8</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="BgSideBrush" Color="{StaticResource BgSideColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="ErrBrush" Color="{StaticResource ErrColor}" />
    <SolidColorBrush x:Key="OkTileBrush" Color="{StaticResource OkTileColor}" />
    <SolidColorBrush x:Key="WarnTileBrush" Color="{StaticResource WarnTileColor}" />
    <SolidColorBrush x:Key="ErrTileBrush" Color="{StaticResource ErrTileColor}" />
    <SolidColorBrush x:Key="AccentTileBrush" Color="{StaticResource AccentTileColor}" />
    <SolidColorBrush x:Key="OkSoftBrush" Color="{StaticResource OkSoftColor}" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}" />
    <SolidColorBrush x:Key="ErrSoftBrush" Color="{StaticResource ErrSoftColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="BtnHoverBrush" Color="{StaticResource BtnHoverColor}" />
    <SolidColorBrush x:Key="BtnPressedBrush" Color="{StaticResource BtnPressedColor}" />
    <SolidColorBrush x:Key="BtnHoverBorderBrush" Color="{StaticResource BtnHoverBorderColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="{StaticResource RowSelectedColor}" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DangerPressedColor}" />
    <SolidColorBrush x:Key="PinGoldBrush" Color="{StaticResource PinGoldColor}" />
    <SolidColorBrush x:Key="SoftAccentBrush" Color="{StaticResource SoftAccentColor}" />

    <DropShadowEffect x:Key="GlowOk" Color="{StaticResource OkColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.10" />
    <DropShadowEffect x:Key="GlowWarn" Color="{StaticResource WarnColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.10" />
    <DropShadowEffect x:Key="GlowErr" Color="{StaticResource ErrColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.12" />
    <DropShadowEffect x:Key="GlowAccent" Color="{StaticResource AccentColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.12" />
    <DropShadowEffect x:Key="CardShadow" Color="{StaticResource ShadowColor}" BlurRadius="14" ShadowDepth="1" Direction="270" Opacity="0.18" />

</ResourceDictionary>