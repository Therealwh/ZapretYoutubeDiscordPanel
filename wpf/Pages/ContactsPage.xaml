<UserControl x:Class="Ydp.Pages.ContactsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">

            <TextBlock Style="{StaticResource H1}" Text="Контакты" />
            <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,16"
                       Text="Связаться с автором и следить за обновлениями." />

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12" MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Канал в Telegram" FontSize="15" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,12"
                               Text="Новости панели, обновления zapret и разборы." />
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="@wtfpoxy" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Открыть канал" Style="{StaticResource BtnPrimary}" Margin="0,0,10,0"
                                Click="BtnOpenChannel_Click" />
                        <Button Content="Скопировать ссылку" Style="{StaticResource Btn}"
                                Click="BtnCopyChannel_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18" MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Панель" FontSize="15" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Dim}"
                               Text="Zapret Panel — настольная панель для zapret (обход DPI) с встроенным прокси Telegram." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
