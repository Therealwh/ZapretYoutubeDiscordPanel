<UserControl x:Class="Ydp.Pages.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
    <!-- Форма выше окна: без скролла нижние поля недоступны. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Диагностика" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
            <Button Content="Запустить проверку" Style="{StaticResource BtnPrimary}" Margin="16,0,0,0" Click="BtnRun_Click" />
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
            <ItemsControl x:Name="Items">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- State dot: the same green/red language as the
                                 dashboard tiles, so a failing check needs no
                                 reading at all. -->
                            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource ErrBrush}" />
                                        <Setter Property="Effect" Value="{DynamicResource GlowErr}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding state}" Value="ok">
                                                <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                                <Setter Property="Effect" Value="{DynamicResource GlowOk}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding state}" Value="warn">
                                                <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                                <Setter Property="Effect" Value="{DynamicResource GlowWarn}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding name}" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding detail}" Style="{StaticResource Dim}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding verdict}" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding state}" Value="ok">
                                                <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding state}" Value="warn">
                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!--
             "Почему не работает": an ordered chain instead of one verdict.
             DNS stub / dead TCP / cut TLS look identical from the outside, but
             they need different fixes, so the first failing step names the fix.
        -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Почему не работает" Style="{StaticResource H1}" VerticalAlignment="Center" />
                    <Button x:Name="BtnWhy" Content="Разобрать" Style="{StaticResource BtnPrimary}" Margin="16,0,0,0" Click="BtnWhy_Click" />
                </StackPanel>
                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,10" TextWrapping="Wrap"
                           Text="Проверяет по порядку: запущен ли обход, отдаёт ли DNS настоящий адрес, проходит ли TCP 443 и завершается ли TLS. Первая упавшая проверка и есть причина." />

                <ItemsControl x:Name="WhyItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Top" Margin="2,5,12,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource ErrBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding state}" Value="good">
                                                    <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding state}" Value="warn">
                                                    <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding state}" Value="skip">
                                                    <Setter Property="Fill" Value="{DynamicResource TextDimBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding title}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding detail}" Style="{StaticResource Dim}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="WhyVerdictBox" Background="{DynamicResource BgHoverBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                        CornerRadius="9" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="WhyVerdict" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Полезные команды" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Если что-то идёт не так, эти команды показывают то же, на что смотрит панель." />
                <TextBox x:Name="Console" IsReadOnly="True" AcceptsReturn="True" Margin="0,10,0,0"
                         Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                         FontFamily="Consolas, Cascadia Mono" FontSize="12"
                         MinHeight="140" Padding="10" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="sc query zapret" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="CmdSc_Click" />
                    <Button Content="Состояние WinDivert" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="CmdWd_Click" />
                    <Button Content="Проверить сеть" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="CmdNet_Click" />
                    <Button Content="Проверить прокси" Style="{StaticResource Btn}" Click="CmdProxy_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>