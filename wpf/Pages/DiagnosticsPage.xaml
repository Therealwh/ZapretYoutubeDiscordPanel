<UserControl x:Class="Ydp.Pages.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Диагностика" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Content="Запустить проверку" Style="{StaticResource BtnPrimary}" Margin="16,0,0,0" Click="BtnRun_Click" />
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
            <ItemsControl x:Name="Items">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding name}" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding detail}" Style="{StaticResource Dim}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding verdict}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Полезные команды" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Если что-то идёт не так, эти команды показывают то же, на что смотрит панель." />
                <TextBox x:Name="Console" IsReadOnly="True" AcceptsReturn="True" Margin="0,10,0,0"
                         Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                         FontFamily="Consolas, Cascadia Mono" FontSize="12"
                         MinHeight="140" Padding="10" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="sc query zapret" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="CmdSc_Click" />
                    <Button Content="Состояние WinDivert" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="CmdWd_Click" />
                    <Button Content="Проверить сеть" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="CmdNet_Click" />
                    <Button Content="Проверить прокси" Style="{StaticResource Btn}" Click="CmdProxy_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>