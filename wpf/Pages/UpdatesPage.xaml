<UserControl x:Class="Ydp.Pages.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
    <!-- Форма выше окна: без скролла нижние поля недоступны. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
    <StackPanel>
        <TextBlock Text="Обновления" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Движок zapret" Style="{StaticResource H1}" />
                <TextBlock x:Name="EngineState" Style="{StaticResource Dim}" Margin="0,6,0,10" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnInstallBundled" Content="Установить встроенный zapret" Style="{StaticResource BtnPrimary}" Margin="0,0,10,0" Click="BtnInstallBundled_Click" />
                    <Button Content="Выбрать zip…" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="BtnChooseZip_Click" />
                    <Button x:Name="BtnReleases" Content="Проверить обновления" Style="{StaticResource Btn}" Click="BtnReleases_Click" />
                </StackPanel>
                <TextBlock x:Name="Releases" Style="{StaticResource Dim}" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Панель" Style="{StaticResource H1}" />
                <TextBlock x:Name="PanelState" Style="{StaticResource Dim}" Margin="0,6,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Проверить обновления панели" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="BtnPanelCheck_Click" />
                    <Button Content="Открыть страницу релизов" Style="{StaticResource Btn}" Click="BtnOpenReleases_Click" />
                </StackPanel>
                <TextBlock x:Name="PanelNote" Style="{StaticResource Dim}" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>