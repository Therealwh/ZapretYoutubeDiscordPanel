<UserControl x:Class="Ydp.Pages.SupportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
    <StackPanel>
        <TextBlock Text="Поддержать проект" Style="{StaticResource SectionTitle}" />
        <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,14" TextWrapping="Wrap"
                   Text="Панель бесплатная и без рекламы. Если она оказалась полезной — можно отправить помощь на любой кошелёк ниже. Каждый адрес копируется кнопкой." />

        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
            <StackPanel>
                <TextBlock Text="USDT · TRC-20" Style="{StaticResource CardTitle}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Trc20" IsReadOnly="True" Padding="10,8"
                             FontFamily="Consolas, Cascadia Mono" FontSize="12.5"
                             Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" />
                    <Button Grid.Column="1" Content="Скопировать" Style="{StaticResource BtnPrimary}"
                            Margin="10,0,0,0" Click="Copy_Click" Tag="Trc20" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
            <StackPanel>
                <TextBlock Text="TRX · TRON" Style="{StaticResource CardTitle}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Trx" IsReadOnly="True" Padding="10,8"
                             FontFamily="Consolas, Cascadia Mono" FontSize="12.5"
                             Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" />
                    <Button Grid.Column="1" Content="Скопировать" Style="{StaticResource BtnPrimary}"
                            Margin="10,0,0,0" Click="Copy_Click" Tag="Trx" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
            <StackPanel>
                <TextBlock Text="USDT · TON" Style="{StaticResource CardTitle}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TonUsdt" IsReadOnly="True" Padding="10,8"
                             FontFamily="Consolas, Cascadia Mono" FontSize="12.5"
                             Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" />
                    <Button Grid.Column="1" Content="Скопировать" Style="{StaticResource BtnPrimary}"
                            Margin="10,0,0,0" Click="Copy_Click" Tag="TonUsdt" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
            <StackPanel>
                <TextBlock Text="GRAM · TON" Style="{StaticResource CardTitle}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TonGram" IsReadOnly="True" Padding="10,8"
                             FontFamily="Consolas, Cascadia Mono" FontSize="12.5"
                             Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" />
                    <Button Grid.Column="1" Content="Скопировать" Style="{StaticResource BtnPrimary}"
                            Margin="10,0,0,0" Click="Copy_Click" Tag="TonGram" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
            <StackPanel>
                <TextBlock Text="BNB · Smart Chain (BEP-20)" Style="{StaticResource CardTitle}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Bnb" IsReadOnly="True" Padding="10,8"
                             FontFamily="Consolas, Cascadia Mono" FontSize="12.5"
                             Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" />
                    <Button Grid.Column="1" Content="Скопировать" Style="{StaticResource BtnPrimary}"
                            Margin="10,0,0,0" Click="Copy_Click" Tag="Bnb" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="Note" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" />
    </StackPanel>
    </ScrollViewer>
</UserControl>