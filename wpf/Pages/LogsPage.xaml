<UserControl x:Class="Ydp.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox x:Name="LevelFilter" Width="130" SelectionChanged="Filter_Changed" Margin="0,0,10,0" />
            <TextBox x:Name="SearchBox" Width="260" Margin="0,0,10,0" Padding="8,6"
                     TextChanged="Filter_Changed" />
            <Button Content="Обновить" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="BtnRefresh_Click" />
            <Button Content="Очистить" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="BtnClear_Click" />
            <Button Content="Экспорт…" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="BtnExport_Click" />
            <Button Content="Показать файл" Style="{StaticResource Btn}" Click="BtnShowFile_Click" />
        </StackPanel>

        <TextBlock x:Name="Meta" Grid.Row="1" Style="{StaticResource Dim}" Margin="0,0,0,8" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <!--
              DataGrid, not ListView+GridView: the list could not be themed
              without replacing the item template, and a replaced template
              either lost the columns or lost the rows. DataGrid already has
              dark headers, cells and a readable selection colour in the theme.
            -->
            <DataGrid x:Name="LogList" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0"
                      HeadersVisibility="Column" CanUserAddRows="False"
                      CanUserResizeRows="False" EnableRowVirtualization="True"
                      GridLinesVisibility="None" SelectionMode="Extended"
                      FontFamily="Segoe UI"
                      HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Время" Width="80" Binding="{Binding ts}" />
                    <DataGridTextColumn Header="Уровень" Width="80" Binding="{Binding level}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                <Style.Triggers>
                                    <!-- Logger writes lowercase; match both cases so a
                                         future upper-case writer is covered too. -->
                                    <DataTrigger Binding="{Binding level}" Value="info">
                                        <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding level}" Value="INFO">
                                        <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding level}" Value="warn">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding level}" Value="WARN">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding level}" Value="error">
                                        <Setter Property="Foreground" Value="{StaticResource ErrBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding level}" Value="ERROR">
                                        <Setter Property="Foreground" Value="{StaticResource ErrBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Источник" Width="120" Binding="{Binding source}" />
                    <DataGridTextColumn Header="Сообщение" Width="*" Binding="{Binding msg}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <!-- Trim instead of clip: the full line stays
                                     readable via the cell tooltip. -->
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding msg}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>