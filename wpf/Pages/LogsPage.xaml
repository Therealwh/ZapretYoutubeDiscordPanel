<UserControl x:Class="Ydp.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox x:Name="LevelFilter" Width="130" SelectionChanged="Filter_Changed" Margin="0,0,10,0" />
            <TextBox x:Name="SearchBox" Width="260" Margin="0,0,10,0" Padding="8,6"
                     TextChanged="Filter_Changed" />
            <Button Content="Обновить" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="BtnRefresh_Click" />
            <Button Content="Очистить" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="BtnClear_Click" />
            <Button Content="Экспорт…" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="BtnExport_Click" />
            <Button Content="Показать файл" Style="{StaticResource Btn}" Click="BtnShowFile_Click" />
        </StackPanel>

        <TextBlock x:Name="Meta" Grid.Row="1" Style="{StaticResource Dim}" Margin="0,0,0,8" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ListView x:Name="LogList" Background="Transparent" BorderThickness="0"
                      Foreground="{StaticResource TextBrush}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Время" Width="70" DisplayMemberBinding="{Binding ts}" />
                        <GridViewColumn Header="Уровень" Width="70" DisplayMemberBinding="{Binding level}" />
                        <GridViewColumn Header="Источник" Width="110" DisplayMemberBinding="{Binding source}" />
                        <GridViewColumn Header="Сообщение" Width="900" DisplayMemberBinding="{Binding msg}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>