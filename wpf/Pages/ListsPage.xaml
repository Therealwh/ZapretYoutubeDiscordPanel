<UserControl x:Class="Ydp.Pages.ListsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="TabGeneral" GroupName="lists" Content="Основной список" IsChecked="True"
                         Foreground="{DynamicResource TextBrush}" Margin="0,0,16,0" Checked="Tab_Changed" />
            <RadioButton x:Name="TabExclude" GroupName="lists" Content="Исключения"
                         Foreground="{DynamicResource TextBrush}" Margin="0,0,16,0" Checked="Tab_Changed" />
            <RadioButton x:Name="TabIpset" GroupName="lists" Content="IPSet-исключения"
                         Foreground="{DynamicResource TextBrush}" Checked="Tab_Changed" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Сохранить" Style="{StaticResource BtnPrimary}" Margin="0,0,10,0" Click="BtnSave_Click" />
                <Button Content="Убрать дубликаты" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="BtnDedupe_Click" />
                <Button Content="Отсортировать" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="BtnSort_Click" />
                <Button Content="Очистить комментарии и пустые" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="BtnCleanup_Click" />
                <TextBlock x:Name="Stats" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <!-- Presets: a ready-made domain list instead of assembling it by hand.
                 They write into the "general" list. -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Готовый список доменов:" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="Discord" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="BtnPresetDiscord_Click"
                        ToolTip="Заполнить категорию «Discord» в основном списке" />
                <Button Content="YouTube" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="BtnPresetYoutube_Click"
                        ToolTip="Заполнить категорию «YouTube» в основном списке" />
                <Button Content="Telegram" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="BtnPresetTelegram_Click"
                        ToolTip="Домены, нужные встроенному прокси Telegram" />
                <Button Content="Разложить по категориям" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="BtnOrganize_Click"
                        ToolTip="Разложить текущий список по секциям Discord / YouTube / Telegram / Другое, ничего не удаляя" />
                <Button Content="Очистить список" Style="{StaticResource Btn}" Click="BtnPresetClear_Click"
                        ToolTip="Убрать все домены (домены Telegram панель вернёт сама)" />
            </StackPanel>
        </StackPanel>

        <!-- Quick add: type a site, press the button, it lands in the user list
             and winws picks it up on the next restart. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Добавить свой сайт в обход:" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="QuickDomain" Width="320" Background="Transparent" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource OkBrush}" BorderThickness="1" Padding="6,4"
                             FontFamily="Consolas, Cascadia Mono" FontSize="13"
                             KeyDown="QuickDomain_KeyDown"
                             ToolTip="Например: example.com или https://example.com/page" />
                    <Button x:Name="BtnQuickAdd" Content="Добавить" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="BtnQuickAdd_Click" />
                    <Button x:Name="BtnQuickRemove" Content="Убрать" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="BtnQuickRemove_Click"
                            ToolTip="Удалить домен из списка своих сайтов" />
                    <Button x:Name="BtnQuickRestart" Content="Применить (перезапуск обхода)" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="BtnQuickRestart_Click"
                            ToolTip="Перезапустить обход, чтобы новый сайт начал обходиться прямо сейчас" />
                </StackPanel>
                <TextBlock x:Name="QuickNote" Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Домен попадает в «Пользовательский список» ниже и обрабатывается всеми стратегиями." />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <TextBox x:Name="Editor" Background="Transparent" Foreground="{DynamicResource TextBrush}"
                     BorderThickness="0" AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Consolas, Cascadia Mono" FontSize="13"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Padding="14" />
        </Border>
    </Grid>
</UserControl>