<UserControl x:Class="Ydp.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
    <StackPanel>

        <!-- Power card -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SwitchTrack" Grid.Column="0" Width="56" Height="32" CornerRadius="16"
                        Background="{StaticResource BorderBrush2}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Обход" Style="{StaticResource H1}" />
                    <TextBlock x:Name="PowerState" Text="Выключен" Style="{StaticResource Dim}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnAuto" Content="Подключить рабочий обход" Style="{StaticResource BtnPrimary}"
                            Margin="0,0,10,0" Click="BtnAuto_Click" />
                    <Button x:Name="BtnRestart" Content="Перезапустить" Style="{StaticResource Btn}" Click="BtnRestart_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status tiles -->
        <UniformGrid Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="Стратегия" Style="{StaticResource Dim}" />
                    <TextBlock x:Name="StatStrategy" Text="—" Style="{StaticResource Value}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="Режим" Style="{StaticResource Dim}" />
                    <TextBlock x:Name="StatMode" Text="—" Style="{StaticResource Value}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Служба zapret" Style="{StaticResource Dim}" />
                    <TextBlock x:Name="StatZapret" Text="—" Style="{StaticResource Value}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="Служба WinDivert" Style="{StaticResource Dim}" />
                    <TextBlock x:Name="StatWinDivert" Text="—" Style="{StaticResource Value}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="Процесс winws" Style="{StaticResource Dim}" />
                    <TextBlock x:Name="StatWinws" Text="—" Style="{StaticResource Value}" />
                    <TextBlock x:Name="StatWinwsPath" Text="" Style="{StaticResource Dim}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Папка zapret" Style="{StaticResource Dim}" />
                    <TextBlock x:Name="StatRoot" Text="—" Style="{StaticResource Value}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Telegram proxy -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Telegram (MTProto → WebSocket)" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock x:Name="TgHint" Text="Локальный прокси на 127.0.0.1:1443" Style="{StaticResource Dim}" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock x:Name="TgState" Text="Выключен" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock x:Name="TgStats" Text="" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Запустить" Style="{StaticResource BtnPrimary}" Margin="0,0,10,0" />
                    <Button Content="Открыть в Telegram" Style="{StaticResource Btn}" Margin="0,0,10,0" />
                    <Button Content="Копировать ссылку" Style="{StaticResource Btn}" Margin="0,0,10,0" />
                    <Button Content="Новый секрет" Style="{StaticResource Btn}" />
                </StackPanel>
                <TextBlock x:Name="TgLink" Text="" Style="{StaticResource Dim}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>