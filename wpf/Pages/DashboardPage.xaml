<UserControl x:Class="Ydp.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded"
             Unloaded="Page_Unloaded">
    <StackPanel>

        <!-- Status strip: one line that answers "what is going on right now" -->
        <Border x:Name="BypassCard" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The switch is the primary control on this page, so it has to work.
                     It used to be a plain Border with no handler: it looked
                     clickable and silently did nothing. -->
                <Border x:Name="SwitchTrack" Grid.Column="0" Width="58" Height="34" CornerRadius="17"
                        Background="{StaticResource BorderBrush2}" VerticalAlignment="Center"
                        Cursor="Hand" MouseLeftButtonUp="Switch_Click" ToolTip="Включить или выключить обход">
                    <Ellipse x:Name="Knob" Width="26" Height="26" Fill="{StaticResource TextDimBrush}"
                             HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Обход" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="PowerState" Text="Выключен" Style="{StaticResource Hint}" />
                    <!-- Connecting takes tens of seconds (service swap + probes),
                         so the wait has to be visible or it reads as a freeze. -->
                    <StackPanel x:Name="BusyPanel" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                        <ProgressBar x:Name="BusyBar" Width="90" Height="4" VerticalAlignment="Center"
                                     IsIndeterminate="True" Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource BgHoverBrush}" />
                        <TextBlock x:Name="BusyText" Text="Подключаю…" Margin="8,0,0,0" Style="{StaticResource Hint}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnAuto" Content="Подключить рабочий обход" Style="{StaticResource BtnPrimary}"
                            Margin="0,0,10,0" Click="BtnAuto_Click" />
                    <Button x:Name="BtnRestart" Content="Перезапустить" Style="{StaticResource Btn}"
                            Margin="0,0,10,0" Click="BtnRestart_Click" />
                    <Button x:Name="BtnStop" Content="Остановить" Style="{StaticResource Btn}" Click="BtnStop_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status tiles -->
        <UniformGrid Columns="4" Margin="0,0,0,14">
            <Border x:Name="TileStrategy" Style="{StaticResource TileIdle}" Margin="0,0,8,8" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="ТЕКУЩАЯ СТРАТЕГИЯ" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="StatStrategy" Text="—" Style="{StaticResource TileValue}" />
                    <TextBlock x:Name="StatStrategySub" Text="" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border x:Name="TileMode" Style="{StaticResource TileIdle}" Margin="0,0,8,8" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="РЕЖИМ" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="StatMode" Text="—" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border x:Name="TileZapret" Style="{StaticResource TileIdle}" Margin="0,0,8,8" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="СЛУЖБА ZAPRET" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="StatZapret" Text="—" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border x:Name="TileWinDivert" Style="{StaticResource TileIdle}" Margin="0,0,0,8" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="WINDIVERT" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="StatWinDivert" Text="—" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border x:Name="TileWinws" Style="{StaticResource TileIdle}" Margin="0,0,8,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="ПРОЦЕСС WINWS" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="StatWinws" Text="—" Style="{StaticResource TileValue}" />
                    <TextBlock x:Name="StatWinwsPath" Text="" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border x:Name="TileRoot" Style="{StaticResource TileIdle}" Margin="0,0,8,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="ПАПКА ZAPRET" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="StatRoot" Text="—" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border x:Name="TileAutostart" Style="{StaticResource TileIdle}" Margin="0,0,0,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="АВТОЗАПУСК" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="StatAutostart" Text="—" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Telegram proxy + quick actions -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Telegram · MTProto → WebSocket" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="TgState" Text="Выключен" Style="{StaticResource Hint}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock x:Name="TgHint" Text="Локальный прокси на 127.0.0.1:1443" Style="{StaticResource Hint}"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="TgStats" Text="" Style="{StaticResource Hint}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnTgToggle" Content="Запустить" Style="{StaticResource BtnPrimary}"
                                Margin="0,0,8,0" Click="BtnTgToggle_Click" />
                        <Button Content="Открыть в Telegram" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="BtnTgOpen_Click" />
                        <Button x:Name="BtnTgFree" Content="Освободить порт" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="BtnTgFree_Click"
                                ToolTip="Найти и закрыть процесс, который держит порт прокси (старый экземпляр панели, winws и т.п.)" />
                        <Button Content="Копировать ссылку" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="BtnTgCopy_Click" />
                        <Button Content="Новый секрет" Style="{StaticResource Btn}" Click="BtnTgRegen_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TgLink" Text="" Style="{StaticResource Mono}" Margin="0,10,0,0"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Веб-прокси: отдельный способ зайти в Telegram, когда локальный прокси не нужен -->
                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,14,0,12" />
                    <TextBlock Text="Веб-прокси (Telegram Web)" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10"
                               Text="Отдельный прокси, который работает через браузер. Нужен, если локальный MTProto-прокси недоступен." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="АДРЕС" Style="{StaticResource TileLabel}" />
                            <TextBox x:Name="WebServerBox" Padding="9,7" FontSize="12.5" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="СЕКРЕТ" Style="{StaticResource TileLabel}" />
                            <TextBox x:Name="WebSecretBox" Padding="9,7" FontSize="12.5" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="BtnWebConnect" Content="Подключить" Style="{StaticResource BtnPrimary}"
                                Margin="0,0,8,0" Click="BtnWebConnect_Click" />
                        <Button Content="Копировать адрес" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="BtnCopyServer_Click" />
                        <Button Content="Копировать секрет" Style="{StaticResource Btn}" Click="BtnCopySecret_Click" />
                    </StackPanel>
                    <TextBlock x:Name="WebNote" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Быстрые действия" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                    <Button Content="Стратегии" Style="{StaticResource Btn}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Margin="0,0,0,8" Tag="strategies" Click="Nav_Click" />
                    <Button Content="Подбор и тест стратегий" Style="{StaticResource Btn}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="BtnFindWorking_Click" />
                    <Button Content="Проверить обход" Style="{StaticResource Btn}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="BtnVerify_Click" />
                    <Button Content="Диагностика" Style="{StaticResource Btn}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Margin="0,0,0,8" Tag="diagnostics" Click="Nav_Click" />
                    <Button Content="Обновить zapret" Style="{StaticResource Btn}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Margin="0,0,0,8" Tag="updates" Click="Nav_Click" />
                    <Button Content="Логи" Style="{StaticResource Btn}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Tag="logs" Click="Nav_Click" />
                    <TextBlock x:Name="QuickNote" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
