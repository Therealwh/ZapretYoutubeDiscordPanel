<UserControl x:Class="Ydp.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
    <!-- The settings list is taller than the window on 1366x768, and a bare
         StackPanel silently clipped the rest with no way to reach it. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,10,0">
    <StackPanel>
        <TextBlock Text="Настройки" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

        <!-- Autostart: the feature the user asked for -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Запуск при загрузке Windows" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,10"
                           Text="Панель запускается вместе с Windows и сразу применяет запомненную рабочую стратегию — заходить в программу не нужно." />
                <CheckBox x:Name="ChkAutostart" Content="Запускать панель при входе в Windows"
                          Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"
                          Checked="ChkAutostart_Changed" Unchecked="ChkAutostart_Changed" />
                <CheckBox x:Name="ChkAutoApply" Content="Применять запомненную стратегию автоматически"
                          Foreground="{StaticResource TextBrush}" IsEnabled="{Binding ElementName=ChkAutostart, Path=IsChecked}"
                          Checked="ChkAutoApply_Changed" Unchecked="ChkAutoApply_Changed" />
                <TextBlock x:Name="AutoNote" Style="{StaticResource Dim}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Remembered strategy -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Запомненная стратегия" Style="{StaticResource H1}" />
                <TextBlock x:Name="Remembered" Style="{StaticResource Value}" Margin="0,6,0,4" Text="—" />
                <TextBlock x:Name="RememberedList" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Применить сейчас" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="BtnApplyRemembered_Click" />
                    <Button Content="Забыть" Style="{StaticResource Btn}" Click="BtnForget_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Zapret folder -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Папка zapret" Style="{StaticResource CardTitle}" />
                <TextBlock x:Name="RootValue" Style="{StaticResource Value}" Margin="0,6,0,4" Text="—" />
                <TextBlock x:Name="RootIssues" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Папка может содержать пробелы — в версии 2.0 служба устанавливается через API Windows, без cmd.exe, поэтому путь с пробелами работает." />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Выбрать папку…" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="BtnChooseRoot_Click" />
                    <Button Content="Найти автоматически" Style="{StaticResource Btn}" Click="BtnAutoRoot_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Service mode -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Свой Cloudflare worker для Telegram" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8" TextWrapping="Wrap"
                           Text="Если в вашей сети адреса Telegram недоступны напрямую, помогает собственный worker: он подключается к Telegram со стороны Cloudflare, а панель обращается к обычному домену. Свой worker бесплатен, инструкция — в документации проекта tg-ws-proxy (docs/CfWorker.md)." />
                <TextBox x:Name="WorkerBox" Padding="10,8" Margin="0,0,0,4" TextChanged="WorkerBox_TextChanged"
                         ToolTip="Домен вашего воркера, например patient-band-1850.workers.dev" />
                <TextBlock x:Name="WorkerHint" Style="{StaticResource Hint}" Margin="2,0,0,10" TextWrapping="Wrap"
                           Text="Не задан. Пример: patient-band-1850.workers.dev — без него панель идёт к Telegram напрямую." />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Сохранить" Style="{StaticResource BtnPrimary}" Margin="0,0,10,0" Click="BtnSaveWorker_Click" />
                    <Button x:Name="BtnProbeWorker" Content="Проверить маршруты" Style="{StaticResource Btn}" Click="BtnProbeRoutes_Click" />
                </StackPanel>
                <TextBlock x:Name="WorkerNote" Style="{StaticResource Hint}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Zapret folder -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Свой Cloudflare-релей для Telegram" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8" TextWrapping="Wrap"
                           Text="Если в Cloudflare сделаны записи kws1..kws6.&lt;ваш домен&gt; на IP Telegram, укажите домен здесь — прокси пойдёт через них, а Cloudflare обратится к Telegram вместо вас. Домены должны быть прописаны и в списках zapret (вкладка «Списки»), иначе обход их не пропустит." />
                <TextBox x:Name="CfProxyBox" Padding="10,8" Margin="0,0,0,4" TextChanged="CfProxyBox_TextChanged"
                         ToolTip="Ваш домен, например wtfprivet.online" />
                <TextBlock x:Name="CfProxyHint" Style="{StaticResource Hint}" Margin="2,0,0,10" TextWrapping="Wrap"
                           Text="Не задан. Пример: wtfprivet.online — в Cloudflare должны быть записи kws1..kws6 на этот домен." />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Сохранить" Style="{StaticResource BtnPrimary}" Margin="0,0,10,0" Click="BtnSaveCfProxy_Click" />
                    <Button x:Name="BtnProbe" Content="Проверить маршруты" Style="{StaticResource Btn}" Click="BtnProbeRoutes_Click" />
                    <Button Content="Добавить домен в списки zapret" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="BtnAddToLists_Click" />
                </StackPanel>
                <TextBlock x:Name="CfProxyNote" Style="{StaticResource Hint}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- When the resolver itself is what is being cut -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="YouTube пишет «нет подключения к интернету»" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,10" TextWrapping="Wrap"
                           Text="Интернет при этом есть — YouTube и Discord открываются. Значит режется системный DNS-резолвер, а не трафик. Помогает переключение на публичные DNS. Изменение легко откатить кнопкой справа." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Основной DNS" Style="{StaticResource Dim}" Margin="0,0,0,4" />
                        <TextBox x:Name="DnsPrimaryBox" Padding="10,8" Text="8.8.8.8" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Запасной DNS" Style="{StaticResource Dim}" Margin="0,0,0,4" />
                        <TextBox x:Name="DnsSecondaryBox" Padding="10,8" Text="77.88.8.8" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Сетевой адаптер" Style="{StaticResource Dim}" Margin="0,0,0,4" />
                        <ComboBox x:Name="DnsAdapterBox" Padding="8,6" SelectionChanged="DnsAdapterBox_SelectionChanged" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Применить DNS" Style="{StaticResource BtnPrimary}" Margin="0,0,10,0" Click="BtnApplyDns_Click" />
                    <Button Content="Вернуть от провайдера" Style="{StaticResource Btn}" Click="BtnResetDns_Click" />
                </StackPanel>
                <TextBlock x:Name="DnsNote" Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Service mode -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Режим запуска" Style="{StaticResource H1}" />
                <CheckBox x:Name="ChkServiceMode" Content="Ставить стратегию как службу Windows (автозапуск с ОС)"
                          Foreground="{StaticResource TextBrush}" Margin="0,8,0,4"
                          Checked="ChkServiceMode_Changed" Unchecked="ChkServiceMode_Changed" />
                <TextBlock x:Name="AdminNote" Style="{StaticResource Dim}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>